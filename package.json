{
  "name": "@ing.jorgeu/wargaming-overlay",
  "version": "2.4.0",
  "description": "Overlay local para OBS con lectura Android por ADB",
  "bin": {
    "wargaming-overlay": "cli.js"
  },
  "scripts": {
    "start": "node cli.js start",
    "test": "node --test",
    "prepublishOnly": "npm test",
    "facts:coverage": "node scripts/fact-coverage.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "cli.js",
    "diagnostics.js",
    "server.js",
    "reader.py",
    "battle_reader.py",
    "game-store.js",
    "turn-tracker.js",
    "public",
    "README.md",
    "platform.js",
    "PUBLISHING.md",
    "THIRD_PARTY_ASSETS.md",
    "LICENSE",
    "listhammer.js",
    "announcements.js",
    "data/faction-facts.json",
    "factions.js",
    "scripts/fact-coverage.js",
    "device_connection.py"
  ],
  "license": "0BSD",
  "publishConfig": {
    "access": "public"
  },
  "os": [
    "darwin",
    "win32",
    "linux"
  ],
  "keywords": [
    "obs",
    "overlay",
    "wargaming",
    "adb",
    "cli"
  ]
}
