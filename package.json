{
  "name": "@ing.jorgeu/wargaming-overlay",
  "version": "3.2.0",
  "description": "Overlay local para OBS con lectura Android por ADB",
  "bin": {
    "wargaming-overlay": "cli.js",
    "warhammer-overlay": "cli.js"
  },
  "scripts": {
    "start": "node cli.js start",
    "test": "node --test",
    "prepublishOnly": "npm test",
    "facts:coverage": "node scripts/fact-coverage.js",
    "test-tts": "node scripts/tts-demo.js",
    "setup-tts": "node scripts/setup-kokoro.js",
    "start:remote-lists": "node remote-lists/start.js",
    "dev:remote-lists": "node --env-file=.env.dev remote-lists/dev.js",
    "desktop:start": "npm --prefix desktop start",
    "desktop:package": "npm --prefix desktop run package",
    "desktop:make": "npm --prefix desktop run make"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "cli.js",
    "diagnostics.js",
    "server.js",
    "reader.py",
    "battle_reader.py",
    "game-store.js",
    "rosters.js",
    "reader-status.js",
    "turn-tracker.js",
    "public",
    "README.md",
    "platform.js",
    "PUBLISHING.md",
    "THIRD_PARTY_ASSETS.md",
    "LICENSE",
    "listhammer.js",
    "announcements.js",
    "data/faction-facts.json",
    "factions.js",
    "scripts/fact-coverage.js",
    "device_connection.py",
    "youtube",
    "tts",
    "scripts/tts-demo.js",
    "scripts/setup-kokoro.js",
    "remote-lists"
  ],
  "license": "0BSD",
  "publishConfig": {
    "access": "public"
  },
  "os": [
    "darwin",
    "win32",
    "linux"
  ],
  "keywords": [
    "obs",
    "overlay",
    "wargaming",
    "adb",
    "cli"
  ],
  "dependencies": {
    "@echogarden/espeak-ng-emscripten": "0.3.5",
    "@grpc/grpc-js": "^1.14.5",
    "@grpc/proto-loader": "^0.8.1",
    "onnxruntime-node": "1.30.0",
    "onnxruntime-web": "1.30.0"
  },
  "optionalDependencies": {
    "node-cpal": "1.0.0"
  }
}
