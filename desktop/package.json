{
  "name": "wargaming-overlay-desktop",
  "productName": "Wargaming Overlay",
  "version": "3.3.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make --targets=@electron-forge/maker-zip",
    "prepare:runtimes": "node scripts/prepare-runtimes.js",
    "prepare:runtime": "node scripts/prepare-package.js",
    "prepackage": "npm run prepare:runtime",
    "premake": "npm run prepare:runtime",
    "make:dmg": "electron-forge make --targets=@electron-forge/maker-dmg"
  },
  "dependencies": {
    "@ing.jorgeu/wargaming-overlay": "file:runtime-package.tgz"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-dmg": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "appdmg": "^0.6.6",
    "electron": "44.7.2"
  },
  "config": {
    "forge": "./forge.config.js"
  }
}
