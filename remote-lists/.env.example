# Backend remoto; copia este archivo fuera del repo o a un .env ignorado.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
REMOTE_LISTS_MANAGER_TOKEN=
REMOTE_LISTS_PORT=8080
REMOTE_LISTS_HOST=0.0.0.0
REMOTE_LISTS_DATA_DIR=./remote-lists-data
REMOTE_LISTS_TOKEN_BUDGET=500000
REMOTE_LISTS_MAX_IMPORTS=2
REMOTE_LISTS_MAX_OUTPUT_TOKENS=4000
REMOTE_LISTS_OPEN_MINUTES=30
REMOTE_LISTS_TRUST_PROXY=false

# Solo para pruebas locales, sin llamadas pagadas (resultado de ejemplo).
REMOTE_LISTS_DEMO=false
# Las fichas se guardan en DATA_DIR/references-11 y expiran a los 7 días.
